# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "The binance-sim binary, with its market anchored to a reference venue"
description:
  "The binance-sim executable and the -anchor flags: live (binance-client's Live_feed), raw minute file and event log reference sources through price-anchor. A separate package because binance-client's tests depend on binance-sim."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/binance-sim"
bug-reports: "https://github.com/winterchill-trading/binance-sim/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "yojson"
  "exchange-core"
  "exchange-core-engine"
  "market-data"
  "price-anchor"
  "binance-client"
  "binance-sim" {= version}
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/binance-sim.git"
